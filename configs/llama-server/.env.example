# Copy to .env (gitignored) and fill in real values.
# Never commit the real .env or paste tokens into chat / commit messages.

# Hugging Face access token. Required if any model in config/config.yaml
# is gated or private. Leave empty for fully public models.
HF_TOKEN=

# Host paths mounted read-only into the container. Override if your
# layout differs from the defaults baked into docker-compose.yml.
HF_CACHE_DIR=/root/hf
LLAMA_CPP_DIR=/root/llama.cpp
