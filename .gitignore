# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

# Python/Node/shell noise that may appear in installer runs
__pycache__/
*.pyc
node_modules/
.env
.env.local
configs/**/.env
configs/**/.env.local

# Local configuration (user-specific, not committed) — Obsidian installer
local/*
!local/.gitkeep
!local/*.example.yaml
!local/README.md

# Local-only installer artifacts
install.log
*.bak
*.orig

# Temporary
*.tmp
*.log
